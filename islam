<!-- Inline JavaScript for Reactive Micro-Interactions & Verbatim State Handling -->
<script>
  // 1. Live Clock updating every second
  function updateLiveClock() {
    const now = new Date();
    const h = String(now.getHours()).padStart(2, '0');
    const m = String(now.getMinutes()).padStart(2, '0');
    const s = String(now.getSeconds()).padStart(2, '0');
    const timeStr = `${h}:${m}:${s}`;
    
    const liveElem = document.getElementById('live-clock');
    if (liveElem) liveElem.innerText = timeStr;

    const fsElem = document.getElementById('fs-clock-digits');
    if (fsElem) fsElem.innerText = timeStr;
  }
  setInterval(updateLiveClock, 1000);
  updateLiveClock();

  // 2. Interactive Prayer Check Toggle
  let checkedCount = 2; // initial (ซุบฮิ & ซุฮรี)
  function togglePrayerCheck(btn, prayerName) {
    const icon = btn.querySelector('.prayer-check-icon');
    const isChecked = btn.classList.contains('bg-primary');

    if (isChecked) {
      btn.classList.remove('bg-primary', 'text-on-primary');
      btn.classList.add('bg-surface-container-high', 'text-transparent');
      checkedCount = Math.max(0, checkedCount - 1);
    } else {
      btn.classList.add('bg-primary', 'text-on-primary');
      btn.classList.remove('bg-surface-container-high', 'text-transparent');
      checkedCount = Math.min(5, checkedCount + 1);
    }

    // update badge
    const label = document.getElementById('prayer-completion-label');
    if (label) label.innerText = `วันนี้: ${checkedCount} / 5 เวลา`;
    const statToday = document.getElementById('stats-today-count');
    if (statToday) statToday.innerText = `${checkedCount} / 5 เวลา`;
  }

  // 3. Quick Widget Tasbih
  let quickCount = 12;
  const quickTarget = 33;
  function incrementQuickTasbih() {
    quickCount++;
    if (quickCount > quickTarget) quickCount = 1;
    document.getElementById('quick-tasbih-count').innerText = quickCount;
    const pct = (quickCount / quickTarget) * 100;
    document.getElementById('quick-tasbih-bar').style.width = pct + '%';
  }
  function resetQuickTasbih() {
    quickCount = 0;
    document.getElementById('quick-tasbih-count').innerText = quickCount;
    document.getElementById('quick-tasbih-bar').style.width = '0%';
  }

  // 4. Free Tasbih Modal Logic
  let freeCount = 0;
  function incrementFreeTasbih() {
    freeCount++;
    document.getElementById('free-tasbih-count').innerText = freeCount;
  }
  function resetFreeTasbih() {
    freeCount = 0;
    document.getElementById('free-tasbih-count').innerText = 0;
  }
  function setTasbihTarget() {
    const val = prompt('ใส่เป้าหมายการนับซิกรฺ (ค่าปัจจุบัน 33/100):', '33');
    if (val) alert('ตั้งเป้าหมาย ' + val + ' ครั้งเรียบร้อย');
  }

  // 5. Post-Prayer Dhikr Routine (3 -> 33 -> 33 -> 34)
  const dhikrSteps = [
    { title: 'ขอลุแก่โทษ (อิสติฆฟาร)', arabic: 'أَسْتَغْفِرُ ٱللَّهَ', thai: 'อัสตัฆฟิรุลลอฮ์ (ข้าพเจ้าขออภัยโทษต่ออัลลอฮ์)', target: 3 },
    { title: 'ตัสบีหฺ (Tasbih)', arabic: 'سُبْحَانَ ٱللَّهِ', thai: 'ซุบฮานัลลอฮ์ (มหาบริสุทธิ์ยิ่งแด่อัลลอฮ์)', target: 33 },
    { title: 'ตะหฺมีด (Tahmid)', arabic: 'ٱلْحَمْدُ لِلَّهِ', thai: 'อัลฮัมดุลิลลาฮ์ (มวลการสรรเสริญเป็นสิทธิของอัลลอฮ์)', target: 33 },
    { title: 'ตักบีร (Takbir)', arabic: 'ٱللَّهُ أَكْبَرُ', thai: 'อัลลอฮุอักบัร (อัลลอฮ์ทรงเกรียงไกรที่สุด)', target: 34 }
  ];
  let currentStepIdx = 0;
  let currentStepCount = 0;

  function updatePostDhikrUI() {
    const step = dhikrSteps[currentStepIdx];
    document.getElementById('post-dhikr-title').innerText = step.title;
    document.getElementById('post-dhikr-arabic').innerText = step.arabic;
    document.getElementById('post-dhikr-thai').innerText = step.thai;
    document.getElementById('post-dhikr-count').innerText = currentStepCount;
    document.getElementById('post-dhikr-target').innerText = `เป้าหมาย: ${step.target}`;
  }

  function incrementPostDhikr() {
    currentStepCount++;
    const step = dhikrSteps[currentStepIdx];
    if (currentStepCount >= step.target) {
      if (currentStepIdx < dhikrSteps.length - 1) {
        currentStepIdx++;
        currentStepCount = 0;
      } else {
        alert('มาชาอัลลอฮ์ คุณทำการซิกรฺหลังละหมาดครบถ้วนแล้ว!');
        currentStepIdx = 0;
        currentStepCount = 0;
      }
    }
    updatePostDhikrUI();
  }

  function undoPostDhikr() {
    if (currentStepCount > 0) {
      currentStepCount--;
      updatePostDhikrUI();
    }
  }

  function resetPostDhikr() {
    currentStepIdx = 0;
    currentStepCount = 0;
    updatePostDhikrUI();
  }

  // 6. Fullscreen Clock Toggle
  function openFullscreenClock() {
    document.getElementById('fullscreen-clock-view').classList.remove('hidden');
    document.getElementById('fullscreen-clock-view').classList.add('flex');
  }
  function closeFullscreenClock() {
    document.getElementById('fullscreen-clock-view').classList.add('hidden');
    document.getElementById('fullscreen-clock-view').classList.remove('flex');
  }

  // 7. Notification Sound Toggle Feedback
  document.getElementById('btn-sound-toggle').addEventListener('click', function() {
    const isMuted = this.classList.contains('text-primary');
    if (isMuted) {
      this.classList.remove('text-primary');
      alert('ปิดเสียงแจ้งเตือนอาซาน');
    } else {
      this.classList.add('text-primary');
      alert('เปิดเสียงเตือนอาซานอัตโนมัติแล้ว');
    }
  });
